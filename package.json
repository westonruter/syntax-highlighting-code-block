{
	"name": "syntax-highlighting-code-block",
	"version": "1.5.2",
	"description": "Extending the Code block with syntax highlighting rendered on the server, thus being AMP-compatible and having faster frontend performance.",
	"private": true,
	"author": "Weston Ruter",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"wordpress-plugin"
	],
	"prettier": "@wordpress/prettier-config",
	"homepage": "https://github.com/westonruter/syntax-highlighting-code-block",
	"repository": {
		"type": "git",
		"url": "https://github.com/westonruter/syntax-highlighting-code-block.git"
	},
	"bugs": {
		"url": "https://github.com/westonruter/syntax-highlighting-code-block/issues"
	},
	"devDependencies": {
		"@wordpress/api-fetch": "7.51.0",
		"@wordpress/block-editor": "16.0.0",
		"@wordpress/block-library": "10.2.0",
		"@wordpress/blocks": "15.24.0",
		"@wordpress/components": "37.0.0",
		"@wordpress/editor": "14.51.0",
		"@wordpress/element": "8.3.0",
		"@wordpress/env": "11.11.0",
		"@wordpress/eslint-plugin": "25.7.0",
		"@wordpress/hooks": "4.51.0",
		"@wordpress/i18n": "6.24.0",
		"@wordpress/scripts": "33.0.0",
		"date-fns": "^4.0.0",
		"globals": "17.9.0",
		"grunt": "1.6.3",
		"grunt-wp-deploy": "2.1.2",
		"highlight.js": "git+https://github.com/highlightjs/highlight.js.git#9.18.1",
		"husky": "9.1.7",
		"lint-staged": "17.3.0",
		"lodash": "4.18.1",
		"npm-run-all": "4.1.5"
	},
	"scripts": {
		"update": "bin/update-highlight-libs.sh",
		"build": "npm-run-all build:*",
		"build:transform-readme": "npm run transform-readme",
		"build:clean": "if [ -e dist ]; then rm -r dist; fi; if [ -e build ]; then rm -r build; fi; if [ -e syntax-highlighting-code-block ]; then rm -r syntax-highlighting-code-block; fi",
		"build:js": "wp-scripts build src/index.js src/customize-controls.js --output-path=build",
		"build:dist": "bash ./bin/build-dist.sh",
		"build:zip": "if [ -e syntax-highlighting-code-block.zip ]; then rm syntax-highlighting-code-block.zip; fi; vendor/bin/wp dist-archive --plugin-dirname=. dist syntax-highlighting-code-block.zip && echo \"ZIP of build: $(pwd)/syntax-highlighting-code-block.zip\"",
		"deploy": "npm-run-all verify-version-consistency build && unzip syntax-highlighting-code-block.zip && grunt wp_deploy && rm -r syntax-highlighting-code-block",
		"format": "wp-scripts format --ignore-path=.gitignore && npm run lint:js:fix && npm run lint:css:fix && composer phpcbf && composer normalize",
		"generate-language-names": "php ./bin/generate-language-names.php",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"lint": "npm-run-all --parallel lint:*",
		"lint:composer": "composer normalize --dry-run && composer validate --strict --no-check-all",
		"lint:composer:fix": "composer normalize",
		"lint:css": "wp-scripts lint-style --allow-empty-input --ignore-path=.gitignore",
		"lint:css:fix": "npm run lint:css -- --fix",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:js:report": "npm run lint:js -- --output-file lint-js-report.json --format json .",
		"lint:md": "wp-scripts lint-md-docs --ignore-path=.gitignore",
		"lint:php": "composer phpcs",
		"lint:php:fix": "composer phpcbf",
		"lint:phpstan": "composer phpstan",
		"lint:pkg-json": "wp-scripts lint-pkg-json . --ignorePath .gitignore",
		"md5sum:check": "md5sum -c block-library.md5",
		"md5sum:update": "md5sum node_modules/@wordpress/block-library/src/code/edit.js > block-library.md5",
		"plugin-zip": "npm run build",
		"prepare": "husky",
		"start": "wp-scripts start src/index.js src/customize-controls.js --output-path=build",
		"symlink-wp-env-install-paths": "bin/symlink-wp-env-install-paths.sh",
		"transform-readme": "php tools/transform-readme.php",
		"verify-version-consistency": "php tools/verify-version-consistency.php",
		"wp-env": "wp-env"
	},
	"npmpackagejsonlint": {
		"extends": "@wordpress/npm-package-json-lint-config",
		"rules": {
			"require-version": "off"
		}
	},
	"title": "Syntax-highlighting Code Block (with Server-side Rendering)"
}
